def fetch_problem_data(problem_id, version, sha256, tmp_dir):
    """download and extract a version of the problem data into tmp_dir, return the folder"""
    zip_name = os.path.join(tmp_dir, "data.zip")
    extract_dir = os.path.join(tmp_dir, "extract")
    new_copy_name = os.path.join(extract_dir, str(problem_id))

    size, got_sha256 = uoj_download("/problem/%d/%d" % (problem_id, version), zip_name)
    if got_sha256 != sha256:
        raise Exception(
            "the data of problem #%d is not version %d: SHA256 is %s, expected %s"
            % (problem_id, version, got_sha256, sha256)
        )
    os.mkdir(extract_dir)
    execute("unzip -q %s -d %s" % (pipes.quote(zip_name), pipes.quote(extract_dir)))
    os.unlink(zip_name)

    if not os.path.isfile(os.path.join(new_copy_name, "problem.conf")):
        raise Exception("problem.conf is missing in the data of problem #%d" % problem_id)
    return new_copy_name, size


def run_compiler(scratch_dir, work_path, time_limit, command, what):
    """run a compiler in the sandbox that also compiles submissions"""
    main_path = os.path.abspath(uoj_judger_path())
    result_file = os.path.join(scratch_dir, "compiler_result.txt")
    message_file = os.path.join(scratch_dir, "compiler_message.txt")
    for name in (result_file, message_file, os.path.join(scratch_dir, "uoj_overloaded")):
        if os.path.exists(name):
            os.unlink(name)

    subprocess.call(
        [
            main_path + "/run/run_program",
            "--res=" + result_file,
            "--in=/dev/null",
            "--out=stderr",
            "--err=" + message_file,
            "--tl=%d" % time_limit,
            "--ml=2048",
            "--ol=64",
            "--type=compiler",
            "--add-readable-raw=" + main_path + "/include/",
            "--work-path=" + work_path,
        ]
        + command,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    if os.path.exists(os.path.join(scratch_dir, "uoj_overloaded")):
        raise Exception("this judger was too busy to build %s" % what)

    try:
        with open(result_file, "r") as f:
            verdict, _, _, exit_code = [int(x) for x in f.readline().split()]
    except Exception:
        raise Exception("failed to run the compiler of %s" % what)
    if verdict == 0 and exit_code == 0:
        return

    if verdict != 0:
        name = COMPILER_VERDICTS[verdict] if 0 <= verdict < len(COMPILER_VERDICTS) else "failed"
        raise PrepareError("%s: compile error. Compiler %s" % (what, name))
    try:
        with open(message_file, "rb") as f:
            message = f.read(4096).decode("utf-8", errors="replace")
    except OSError:
        message = ""
    raise PrepareError("%s: compile error\n%s" % (what, message))


# The programs that come with the data of a problem are kept once they are built, under a
# name that says everything the build depends on. A checker that did not change is not built
# again for the next version of the data, nor for the copy of the problem in another domain.
PROGRAM_CACHE_ENTRIES = 500
# what run/compile builds with g++ and gcc: the name of the program and one of these endings
C_SOURCE_ENDINGS = [std + ".cpp" for std in ("", "98", "03", "11", "14", "17", "20", "23", "26")]
C_SOURCE_ENDINGS += [std + ".c" for std in ("", "89", "99", "11", "17", "23")]
INCLUDE_LINE = re.compile(rb"^[ \t]*#[ \t]*include\b[ \t]*(.*)$", re.MULTILINE)
INCLUDED_FILE = re.compile(rb'^(?:"([^"\n]+)"|<([^>\n]+)>)[ \t]*(?://.*|/\*.*)?\r?$')
# what pulls the contents of another file into a program without an #include the scan sees
OPAQUE_SOURCE = re.compile(rb"#[ \t]*embed\b|incbin|__has_include|__has_embed")


def program_cache_path(key=""):
    return os.path.join(uoj_judger_path("/cache"), key)


def program_sources(data_dir, step):
    """the files the build of a program reads, as (name in the data, content) pairs, or None
    where that can not be told for sure: then the program is built every time"""
    name = step["name"]
    sources = [f for f in os.listdir(data_dir) if f.startswith(name) and f[len(name) :] in C_SOURCE_ENDINGS]
    if len(sources) != 1:
        # another language, or more than one candidate
        return None
    roots = [sources[0]]
    if step.get("impl") is not None:
        ending = ".cpp" if sources[0].endswith(".cpp") else ".c"
        roots.append(os.path.join("require", step["impl"] + ending))
    include_dir = os.path.abspath(uoj_judger_path("/include"))

    seen = {}
    pending = list(roots)
    while pending:
        rel = os.path.normpath(pending.pop())
        if rel in seen:
            continue
        if rel.startswith("..") or os.path.isabs(rel):
            return None
        path = os.path.join(data_dir, rel)
        try:
            with open(path, "rb") as f:
                content = f.read()
        except OSError:
            return None
        if OPAQUE_SOURCE.search(content):
            return None
        seen[rel] = content
        for line in INCLUDE_LINE.findall(content):
            found = INCLUDED_FILE.match(line.strip())
            if not found:
                # an #include whose file is the result of a macro
                return None
            included = (found.group(1) or found.group(2)).decode(errors="replace")
            if included.startswith("/") or ".." in included.split("/"):
                # a file somewhere else on the judger: not something to build on
                return None
            if found.group(1) is None:
                continue
            # the compiler looks beside the file that includes first, then where -I says
            beside = os.path.join(os.path.dirname(rel), included)
            if os.path.isfile(os.path.join(data_dir, beside)):
                pending.append(beside)
        if len(seen) > 200:
            return None
    return sorted(seen.items())


def include_dir_digest():
    """the headers of the judger that the programs of problems include, like testlib.h"""
    global include_digest
    if include_digest is None:
        digest = hashlib.sha256()
        root = uoj_judger_path("/include")
        for folder, _, files in sorted(os.walk(root)):
            for fname in sorted(files):
                path = os.path.join(folder, fname)
                digest.update(os.path.relpath(path, root).encode() + b"\0")
                with open(path, "rb") as f:
                    digest.update(hashlib.sha256(f.read()).digest())
        include_digest = digest.hexdigest()
    return include_digest


include_digest = None


def program_cache_key(data_dir, step):
    """a name for everything the build of a program depends on, or None when it is not known"""
    try:
        sources = program_sources(data_dir, step)
    except Exception:
        traceback.print_exc()
        return None
    if sources is None:
        return None
    digest = hashlib.sha256()

    def add(part):
        digest.update(b"%d:" % len(part) + part)

    add(json.dumps({key: step.get(key) for key in ("name", "include", "impl", "path")}, sort_keys=True).encode())
    identity = describe_judger()
    add((identity["judger_version"] + "\n" + identity["toolchain"]).encode())
    add(include_dir_digest().encode())
    for rel, content in sources:
        add(rel.encode())
        add(content)
    return digest.hexdigest()


def restore_cached_program(key, binary):
    """put a program that was built before in its place, tell whether there was one"""
    cached = program_cache_path(key)
    if not os.path.isfile(cached):
        return False
    try:
        shutil.copyfile(cached, binary)
        os.chmod(binary, 0o755)
        os.utime(cached)
        return True
    except OSError:
        traceback.print_exc()
        if os.path.exists(binary):
            os.unlink(binary)
        return False


def store_cached_program(key, binary):
    """keep a program that was just built; failing to keep it fails nothing"""
    try:
        if not os.path.isfile(binary):
            return
        os.makedirs(program_cache_path(), exist_ok=True)
        tmp = program_cache_path(".tmp_%d_%s" % (os.getpid(), key))
        shutil.copyfile(binary, tmp)
        os.rename(tmp, program_cache_path(key))
        entries = [program_cache_path(fname) for fname in os.listdir(program_cache_path())]
        entries.sort(key=os.path.getmtime)
        for path in entries[:-PROGRAM_CACHE_ENTRIES]:
            os.unlink(path)
    except OSError:
        traceback.print_exc()


def build_problem_programs(data_dir, steps, scratch_dir):
    """build the programs that come with the data of a problem: checker, validator and so on"""
    main_path = os.path.abspath(uoj_judger_path())
    data_dir = os.path.abspath(data_dir)
    for step in steps or []:
        if step.get("type") == "compile":
            name = step.get("name")
            if name not in ("chk", "std", "val", "interactor"):
                raise PrepareError("unknown program to build: %r" % (name,))
            command = [main_path + "/run/compile"]
            if step.get("include"):
                command.append("--cinclude=" + main_path + "/include")
            if step.get("impl") is not None:
                if step["impl"] != "implementer":
                    raise PrepareError("unknown implementer: %r" % (step["impl"],))
                command.append("--impl=implementer")
            work_path = data_dir
            target = name
            if step.get("path") is not None:
                if step["path"] != "require":
                    raise PrepareError("unknown folder to build in: %r" % (step["path"],))
                work_path = os.path.join(data_dir, "require")
                target = "../" + name
            key = program_cache_key(data_dir, step)
            binary = os.path.join(data_dir, name)
            if key is not None and restore_cached_program(key, binary):
                log_event("program_cache", result="hit", program=name, key=key[:16])
                continue
            run_compiler(scratch_dir, work_path, 15, command + [target], name)
            if key is not None:
                store_cached_program(key, binary)
        elif step.get("type") == "make":
            command = ["/usr/bin/make", "INCLUDE_PATH=" + main_path + "/include"]
            run_compiler(scratch_dir, data_dir, 60, command, "Makefile")
        else:
            raise PrepareError("unknown step to build the data: %r" % (step,))


# how many problems a judger keeps the data of, unless its configuration says otherwise
DATA_CACHE_PROBLEMS = 300


def data_cache_limit():
    """how many problems this judger keeps the data of"""
    limit = jconf.get("data_cache_problems", DATA_CACHE_PROBLEMS)
    if isinstance(limit, bool) or not isinstance(limit, int) or limit < 2:
        return DATA_CACHE_PROBLEMS
    return limit


def evict_problem_data(keep):
    """keep the data of the problems used last, and nothing an interrupted update left behind"""
    data_root = uoj_judger_path("/data")
    folders = []
    for fname in os.listdir(data_root):
        if fname.startswith("."):
            remove_tree(os.path.join(data_root, fname))
        elif os.path.isdir(os.path.join(data_root, fname)):
            folders.append(fname)
    folders.sort(key=lambda fname: os.path.getatime(os.path.join(data_root, fname)))
    for fname in folders[: -(data_cache_limit() - 1)]:
        if fname != keep:
            remove_tree(os.path.join(data_root, fname))
            if os.path.exists(os.path.join(data_root, fname + ".version")):
                os.unlink(os.path.join(data_root, fname + ".version"))


def update_problem_data(problem_id, version, sha256, steps):
    """make data/<problem_id> the given version of the data of a problem, programs included"""
    wanted = {"version": version, "sha256": sha256}
    event = {
        "judger": jconf["judger_name"],
        "problem_id": problem_id,
        "version": version,
        "sha256": sha256,
        "url": uoj_url("/judge/download/problem/%s/%s" % (problem_id, version)),
        "path": os.path.abspath(os.path.join(uoj_judger_path("/data"), str(problem_id))),
    }
    try:
        if isinstance(version, bool) or not isinstance(version, int) or not isinstance(sha256, str):
            raise Exception("the web server has no data for problem #%d" % problem_id)

        data_root = uoj_judger_path("/data")
        copy_name = os.path.join(data_root, str(problem_id))
        if os.path.isdir(copy_name) and cached_data_version(problem_id) == wanted:
            execute("touch -a %s" % pipes.quote(copy_name))
            return

        evict_problem_data(str(problem_id))

        # The data is downloaded, extracted and built in a temporary folder and only moved to
        # its place when it is complete, so a failed update never leaves a broken copy behind.
        for tries_left in range(PROBLEM_DATA_DOWNLOAD_TRIES - 1, -1, -1):
            tmp_dir = tempfile.mkdtemp(prefix=".tmp_%d_" % problem_id, dir=data_root)
            try:
                new_copy_name, event["size"] = fetch_problem_data(problem_id, version, sha256, tmp_dir)
                build_problem_programs(new_copy_name, steps, tmp_dir)
                # without this file the copy is not trusted, so it goes first and comes last
                if os.path.exists(data_version_file(problem_id)):
                    os.unlink(data_version_file(problem_id))
                if os.path.isdir(copy_name):
                    # a folder must be writable to be moved to another folder
                    os.chmod(copy_name, 0o700)
                    os.rename(copy_name, os.path.join(tmp_dir, "old"))
                os.rename(new_copy_name, copy_name)
                execute("chmod -R a-w %s" % pipes.quote(copy_name))
                with open(os.path.join(tmp_dir, "version"), "w") as f:
                    json.dump(wanted, f)
                os.rename(os.path.join(tmp_dir, "version"), data_version_file(problem_id))
                break
            except PrepareError:
                # trying again would not build what does not build
                raise
            except Exception:
                if tries_left == 0:
                    raise
                traceback.print_exc()
                time.sleep(2)
            finally:
                remove_tree(tmp_dir)
    except Exception as e:
        log_event("problem_data_sync", result="%s: %s" % (type(e).__name__, e), **event)
        raise
    else:
        log_event("problem_data_sync", result="ok", **event)


# ---- the data of the problems, ahead of the submissions
#
# A judger fetches the data of a problem when it is given a submission to it. A judger that
# has only just been set up, perhaps far from the web server, would make the first submission
# to every problem wait for that. So a judger with nothing to judge asks the web server which
# data the problems have now, and fetches what it does not hold: one problem at a time, with
# a look for work in between, the data that was published last first.
#
# A judger keeps the data of so many problems (data_cache_problems) and no more. While it has
# room, it fills it. When it is full, it goes on fetching what is published from then on,
# which pushes out the data that was used longest ago, as judging does; it does not go back
# for older data it has no room for, or it would fetch and push out for ever. What it holds
# it keeps up to date.

# seconds between two questions to the web server
DATA_SYNC_INTERVAL = 30
# seconds before data that could not be fetched is tried again
DATA_SYNC_RETRY_AFTER = 600

data_sync_plan = []
data_sync_asked_at = 0
data_sync_failed = {}
data_sync_counts = None
# the newest data this judger has been told of: what comes after it is new
data_sync_seen = None


def data_sync_enabled():
    return jconf.get("data_sync", True) is not False


def cached_data_versions():
    """the versions of the data this judger holds: problem id => what its version file says"""
    cached = {}
    data_root = uoj_judger_path("/data")
    for fname in os.listdir(data_root):
        if fname.isdigit() and os.path.isdir(os.path.join(data_root, fname)):
            cached[int(fname)] = cached_data_version(int(fname))
    return cached


def plan_data_sync(versions, cached, limit, failed, now, seen=None):
    """Which data is to be fetched, in which order, and how much of the data there is is held.

    versions: what the web server has, the newest first: rows of problem id, version, SHA256,
    the steps that build the programs, and a number that grows with every publication.
    cached: what this judger holds. failed: when a version could not be fetched, by (problem
    id, version). seen: the number of the newest publication this judger was told of before,
    None when it is told for the first time.
    """
    plan = []
    have = 0
    room = limit - len(cached)
    for problem_id, version, sha256, steps, serial in versions:
        held = cached.get(problem_id) if problem_id in cached else False
        if held == {"version": version, "sha256": sha256}:
            have += 1
            continue
        if failed.get((problem_id, version), 0) > now - DATA_SYNC_RETRY_AFTER:
            continue
        if held is False:
            # Data of a problem this judger has nothing of takes room. Where there is none,
            # only what was published since the judger last looked is worth pushing out
            # something else for.
            if room > 0:
                room -= 1
            elif seen is None or serial <= seen:
                continue
        plan.append((problem_id, version, sha256, steps))
    return plan, have


def read_data_versions(answer):
    """what the web server said about the data of the problems, as rows that can be relied on"""
    versions = []
    for row in json.loads(answer)["versions"]:
        problem_id, version, sha256, steps, serial = row
        well_typed = all(isinstance(n, int) and not isinstance(n, bool) for n in (problem_id, version, serial))
        if well_typed and isinstance(sha256, str) and (steps is None or isinstance(steps, list)):
            versions.append((problem_id, version, sha256, steps, serial))
    return versions


def sync_data_ahead():
    """one step of fetching data ahead of the submissions; tells whether something was fetched"""
    global data_sync_plan, data_sync_asked_at, data_sync_counts, data_sync_seen

    if not data_sync_enabled():
        return False
    now = time.time()
    if now - data_sync_asked_at >= DATA_SYNC_INTERVAL:
        data_sync_asked_at = now
        try:
            # (a web server that does not know the question is not to answer with a task)
            question = {"data_versions": "1", "fetch_new": "0"}
            if data_sync_counts is not None:
                question["data_have"], question["data_total"] = data_sync_counts
            versions = read_data_versions(uoj_interact(question))
            data_sync_plan, have = plan_data_sync(
                versions, cached_data_versions(), data_cache_limit(), data_sync_failed, now, data_sync_seen
            )
            data_sync_counts = (have, len(versions))
            if versions:
                data_sync_seen = max([row[4] for row in versions] + [data_sync_seen or 0])
        except UOJAuthError as e:
            log(e)
            return False
        except Exception:
            traceback.print_exc()
            return False
    if not data_sync_plan:
        return False

    problem_id, version, sha256, steps = data_sync_plan.pop(0)
    try:
        update_problem_data(problem_id, version, sha256, steps)
    except Exception as e:
        # it is tried again later; a submission to the problem tries at once, and says why not
        data_sync_failed[(problem_id, version)] = time.time()
        log("data of problem #%d was not fetched ahead: %s: %s" % (problem_id, type(e).__name__, e))
        return False
    data_sync_counts = (data_sync_counts[0] + 1, data_sync_counts[1])
    return True


def prepare():
    """build a version of problem data that waits to be published, tell whether it can be used"""
    report = {"prepare_result": "1", "id": submission["prepare"]["id"]}
    try:
        update_problem_data(
            submission["problem_id"],
            submission.get("problem_data_version"),
            submission.get("problem_data_sha256"),
            submission.get("problem_data_prepare"),
        )
    except Exception as e:
        print_judge_client_status()
        traceback.print_exc()
        report.update({"ok": "0", "message": str(e)})
    else:
        report.update({"ok": "1", "message": ""})
    return report


def judge():
    global judging_started

    clean_up_folder(uoj_judger_path("/work"))
    clean_up_folder(uoj_judger_path("/result"))
    update_problem_data(
        submission["problem_id"],
        submission.get("problem_data_version"),
        submission.get("problem_data_sha256"),
        submission.get("problem_data_prepare"),
    )

    with open(uoj_judger_path("/work/submission.conf"), "w") as fconf:
        uoj_download(submission["content"]["file_name"], uoj_judger_path("/work/all.zip"))
        execute("cd %s && unzip -q all.zip && rm all.zip" % pipes.quote(uoj_judger_path("/work")))
        for k, v in submission["content"]["config"]:
            print(k, v, file=fconf)

        if "is_hack" in submission:
            if submission["hack"]["input_type"] == "USE_FORMATTER":
                uoj_download(
                    submission["hack"]["input"], uoj_judger_path("/work/hack_input_raw.txt")
                )
                execute(
                    "%s <%s >%s"
                    % (
                        pipes.quote(uoj_judger_path("/run/formatter")),
                        pipes.quote(uoj_judger_path("/work/hack_input_raw.txt")),
                        pipes.quote(uoj_judger_path("/work/hack_input.txt")),
                    )
                )
            else:
                uoj_download(submission["hack"]["input"], uoj_judger_path("/work/hack_input.txt"))
            print("test_new_hack_only on", file=fconf)
        elif "is_custom_test" in submission:
            print("custom_test on", file=fconf)

    judging_started = True
    try:
        outcome = run_main_judger()
    finally:
        judging_started = False
    if outcome == "given up":
        # Another judger would wait as long for the same thing. The verdict is that of a
        # judgement that failed, and this judger goes on with the next one.
        clean_up_folder(uoj_judger_path("/result"))
        write_judgement_failed(
            "the judgement was not done after %s seconds and was given up" % max_judging_seconds()
        )
        return get_judger_result()
    if outcome != "done":
        raise Exception("failed to execute: main_judger")

    # run_program leaves this file when it gave up because the machine was too busy to judge
    if os.path.exists(uoj_judger_path("/result/uoj_overloaded")):
        raise Exception("this judger was too busy to judge")

    return get_judger_result()


# interact with uoj web server
def uoj_check_response(r, uri):
    if r.status_code == 403:
        raise UOJAuthError(
            "the web server rejected this judger (HTTP 403 from %s), "
            "please check judger_name and judger_password" % uri
        )
    if r.status_code != 200:
        raise Exception("HTTP %d from %s" % (r.status_code, uri))


def uoj_interact(data, files={}):
    data = data.copy()
    data.update({"judger_name": jconf["judger_name"], "password": jconf["judger_password"]})
    r = requests.post(uoj_url("/judge/submit"), data=data, files=files)
    uoj_check_response(r, "/judge/submit")
    return r.text


def uoj_download(uri, filename):
    """download a file from the web server, return its size and its SHA256"""
    data = {"judger_name": jconf["judger_name"], "password": jconf["judger_password"]}
    size = 0
    sha256 = hashlib.sha256()
    r = requests.post(uoj_url("/judge/download" + uri), data=data, stream=True)
    try:
        uoj_check_response(r, "/judge/download" + uri)
        with open(filename, "wb") as f:
            for chunk in r.iter_content(chunk_size=65536):
                if chunk:
                    f.write(chunk)
                    size += len(chunk)
                    sha256.update(chunk)
        expected_size = r.headers.get("Content-Length")
        expected_sha256 = r.headers.get("X-UOJ-SHA256")
        encoded = r.headers.get("Content-Encoding", "identity") != "identity"
    finally:
        r.close()

    if expected_size is not None and not encoded and int(expected_size) != size:
        raise Exception(
            "%s is truncated: got %d bytes, expected %s" % (uri, size, expected_size)
        )
    if expected_sha256 is not None and expected_sha256.lower() != sha256.hexdigest():
        raise Exception(
            "%s is corrupted: SHA256 is %s, expected %s"
            % (uri, sha256.hexdigest(), expected_sha256)
        )
    return size, sha256.hexdigest()


def uoj_sync_judge_client():
    data = {"judger_name": jconf["judger_name"], "password": jconf["judger_password"]}
    ret = requests.post(uoj_url("/judge/sync-judge-client"), data=data).text
    if ret != "ok":
        raise Exception("failed to sync judge clients: %s" % ret)


def read_hack_files():
    """read the data of a successful hack to send to the web server"""
    # The data may be binary, and it is read into memory so that every retry of the request
    # sends it again in full.
    files = {}
    for field, name in (("hack_input", "hack_input.txt"), ("std_output", "std_output.txt")):
        with open(uoj_judger_path("/work/" + name), "rb") as f:
            content = f.read()
        log(
            "hack data: %s size=%d sha256=%s"
            % (name, len(content), hashlib.sha256(content).hexdigest())
        )
        files[field] = (name, content)
    return files


def give_back_report():
    """what tells the web server that this judger could not do the task it was given"""
    report = {"requeue": "1"}
    if "is_hack" in submission:
        report["is_hack"] = True
        report["id"] = submission["hack"]["id"]
    else:
        report["id"] = submission["id"]
        if "is_custom_test" in submission:
            report["is_custom_test"] = True
    return report


def send_and_fetch(result=None, fetch_new=True, report=None):
    global submission

    """send judgement result, and fetch new submission to judge"""

    data = {}
    files = {}

    if not fetch_new:
        # not False: it would be sent as the string "False", which PHP takes for true
        data["fetch_new"] = "0"
    else:
        data["protocol"] = PROTOCOL
        data.update(describe_judger())

    if report is not None:
        data.update(report)

    if result is not None:
        data["submit"] = True
        # the data the judgement was made with
        data["problem_data_version"] = submission.get("problem_data_version")
        data["problem_data_sha256"] = submission.get("problem_data_sha256")
        if "is_hack" in submission:
            data["is_hack"] = True
            data["id"] = submission["hack"]["id"]
            if result != False and result["score"]:
                try:
                    print("succ hack!", file=sys.stderr)
                    files = read_hack_files()
                except Exception:
                    print_judge_client_status()
                    traceback.print_exc()
                    result = False
        elif "is_custom_test" in submission:
            data["is_custom_test"] = True
            data["id"] = submission["id"]
        else:
            data["id"] = submission["id"]

        if result == False:
            result = {"score": 0, "error": "Judgement Failed", "details": "Unknown Error"}
        result["status"] = "Judged"
        data["result"] = json.dumps(result, ensure_ascii=False)

    while True:
        try:
            ret = uoj_interact(data, files)
            print(ret)
        except UOJAuthError as e:
            log(e)
            time.sleep(30)
            continue
        except Exception:
            print_judge_client_status()
            traceback.print_exc()
        else:
            break
        time.sleep(2)

    try:
        submission = json.loads(ret)
    except Exception as e:
        submission = None
        if ret.strip() != "Nothing to judge":
            log("unexpected response from the web server: %r" % ret[:200])
        return False
    else:
        return True


# judge client
def judger_loop():
    ok = False
    while True:
        fetch_new = True

        if ok and not (taskQ.empty() and socket_server_thread.is_alive()):
            fetch_new = False

        if not ok:
            while True:
                if not taskQ.empty():
                    handle_task()
                if not socket_server_thread.is_alive():
                    raise Exception("socket server exited unexpectedly")

                if send_and_fetch():
                    break

                print("[" + time.asctime() + "]", "Nothing to judge...")
                # the time nothing is judged in is the time to fetch data ahead
                if not sync_data_ahead():
                    time.sleep(2)

            ok = True
            print_judge_client_status()
            print("judging", file=sys.stderr)

        if "prepare" in submission:
            ok = send_and_fetch(fetch_new=fetch_new, report=run_task(prepare))
            continue

        try:
            res = run_task(judge)
        except Exception:
            # Nothing was judged: the data could not be fetched or built here, or the machine was
            # too busy. The submission is not to blame, so another judger gets to try.
            print_judge_client_status()
            traceback.print_exc()
            send_and_fetch(fetch_new=False, report=give_back_report())
            # leave the task to the other judgers for a moment
            ok = False
            time.sleep(5)
            continue

        ok = send_and_fetch(result=res, fetch_new=fetch_new)


# main function
def main():
    init()

    if len(sys.argv) == 1:
        start_judger_server()
    if len(sys.argv) == 2:
        if sys.argv[1] == "start":
            pid = os.fork()
            if pid == -1:
                raise Exception("fork failed")
            elif pid > 0:
                return
            else:
                freopen(sys.stdout, open(os.devnull, "wb"))
                freopen(sys.stderr, open("log/judge.log", "ab", buffering=0))
                start_judger_server()
        elif sys.argv[1] == "update":
            try:
                with closing(socket.socket(socket.AF_INET, socket.SOCK_STREAM)) as s:
                    s.connect(("127.0.0.1", jconf["socket_port"]))
                    s.sendall(
                        json.dumps({"password": jconf["socket_password"], "cmd": "update"}).encode()
                    )
                return
            except Exception:
                traceback.print_exc()
                raise Exception("update failed")
        elif sys.argv[1] == "stop":
            try:
                with closing(socket.socket(socket.AF_INET, socket.SOCK_STREAM)) as s:
                    s.connect(("127.0.0.1", jconf["socket_port"]))
                    s.sendall(
                        json.dumps({"password": jconf["socket_password"], "cmd": "stop"}).encode()
                    )
                    if s.recv(10).decode() != "ok":
                        raise Exception("stop failed")
                return
            except Exception:
                traceback.print_exc()
                raise Exception("stop failed")
    raise Exception("invalid argument")


if __name__ == "__main__":
    try:
        main()
    except Exception:
        print_judge_client_status()
        traceback.print_exc()
        sys.exit(1)
