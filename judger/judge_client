    print_judge_client_status()
    print("hello!", file=sys.stderr)

    socket_server_thread = Thread(target=socket_server_loop)
    socket_server_thread.setDaemon(True)
    socket_server_thread.start()

    judger_loop()


# report thread
#
# While a task is being done the web server is told every few seconds that this judger is alive,
# otherwise it gives the task to another judger. The progress of a judgement counts as well.
SIGN_OF_LIFE_INTERVAL = 5

task_finished = True
judging_started = False


def read_judge_status():
    with open(uoj_judger_path("/result/cur_status.txt"), "r") as f:
        fcntl.flock(f, fcntl.LOCK_SH)
        try:
            return f.read(100)
        except Exception:
            return None
        finally:
            fcntl.flock(f, fcntl.LOCK_UN)


def report_loop():
    last_report = time.time()
    while not task_finished:
        try:
            if judging_started and "is_hack" not in submission:
                status = read_judge_status()
                if status is not None:
                    data = {}
                    data["update-status"] = True
                    data["id"] = submission["id"]
                    if "is_custom_test" in submission:
                        data["is_custom_test"] = True
                    data["status"] = status
                    uoj_interact(data)
                    last_report = time.time()
            if time.time() - last_report >= SIGN_OF_LIFE_INTERVAL:
                last_report = time.time()
                uoj_interact({"heartbeat": "1"})
        except Exception:
            pass
        time.sleep(0.2)


def run_task(task):
    """run a function that does a task of the web server, reporting until it returns"""
    global task_finished
    global judging_started

    task_finished = False
    judging_started = False
    report_thread = Thread(target=report_loop)
    report_thread.daemon = True
    report_thread.start()
    try:
        return task()
    finally:
        task_finished = True
        report_thread.join()


# handle task in main thread
def handle_task():
    need_restart = False
    try:
        while True:
            task = taskQ.get_nowait()

            if task["cmd"] == "update":
                try:
                    uoj_download("/judger", "judger_update.zip")
                    execute(
                        "unzip -o judger_update.zip && cd %s && make clean && make"
                        % uoj_judger_path()
                    )
                except:
                    print("error when update", file=sys.stderr)
                if jconf["judger_name"] == "main_judger":
                    uoj_sync_judge_client()
                need_restart = True
            elif task["cmd"] == "stop":
                taskQ.task_done()
                socket_server_thread.join()

                print_judge_client_status()
                print("goodbye!", file=sys.stderr)

                sys.exit(0)

            taskQ.task_done()
    except Empty:
        pass

    if need_restart:
        os.execl("./judge_client", "./judge_client")


