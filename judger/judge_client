# interact with uoj_judger
def get_judger_result():
    res = {}
    # The details quote the data of the problem and the output of the program, which may be
    # anything, including a multi-byte character cut in two by the preview.
    result_file = uoj_judger_path("/result/result.txt")
    with open(result_file, "r", encoding="utf-8", errors="replace") as fres:
        res["score"] = 0
        res["time"] = 0
        res["memory"] = 0
        while True:
            line = fres.readline()
            if line == "":
                break
            line = line.strip()
            if line == "details":
                res["details"] = fres.read()
                break

            sp = line.split()
            assert len(sp) >= 1
            if sp[0] == "error":
                res["error"] = line[len("error") + 1 :]
            else:
                assert len(sp) == 2
                res[sp[0]] = sp[1]
        res["score"] = float(res["score"])
        res["time"] = int(res["time"])
        res["memory"] = int(res["memory"])
    res["status"] = "Judged"
    return res


